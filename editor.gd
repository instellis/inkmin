func resetlangmenu()->void:
	Autoload.mainlang=$inkminreader.languages[0]
	%langmenu.clear()
	%langmenu.add_item(tr("Translations"))
	%langmenu.set_item_disabled(0,true)
	var selected_index:=0
	for lang in $inkminreader.languages:
		if lang!=Autoload.mainlang:
			%langmenu.add_item(lang)
			if lang==Autoload.currentlang:
				selected_index=%langmenu.get_item_count()-1
		else:
			%mainlang.text=Autoload.mainlang
			if %mainlang.is_connected("pressed",chooselang):%mainlang.disconnect("pressed",chooselang)
			%mainlang.connect("pressed",Callable(self,"chooselang").bind(Autoload.mainlang))
	%langmenu.select(selected_index)
	%langmenu.visible=$inkminreader.languages.size()>1
	%mainlang.button_pressed=Autoload.currentlang==Autoload.mainlang

func _on_translation_language_selected(index:int) -> void:
	if index > 0:
		chooselang(%langmenu.get_item_text(index))

func changelanguages(): #called when user changes the languages 

	# select main language as current choice
	var languagelist:=normalizelangarray(Autoload.languages)
	Autoload.languages=languagelist
	Autoload.currentlang=languagelist[0]
	Autoload.mainlang=Autoload.currentlang
	
	# rebuild root json to include all languages
	var rootcontent:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
	if rootcontent.is_empty():
		warning("failed to load root json")
		return
	rootcontent.root.languages=languagelist
	if not $inkminconverter.save_dict_to_json_file(rootcontent,Autoload.jsonfolder+"root.json"):
		knotchanged=true
		return
	displayroot() ; knotchanged=false

	# otherwise: go through jsons and correct language situation for text and choices
	for knot in Autoload.allknots:
		var theknot:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+knot+".json")
		for bloc in theknot:
			if theknot[bloc]["type"]=="text" or theknot[bloc]["type"]=="choice" or theknot[bloc]["type"]=="weave": 
				if not theknot[bloc]["text"] is Dictionary:
					var texttoinsert=theknot[bloc]["text"]
					theknot[bloc]["text"]={} ; theknot[bloc]["text"][Autoload.currentlang]=texttoinsert
					for lang in Autoload.languages:
						if lang!=Autoload.currentlang: theknot[bloc]["text"][lang]="<<translation>>"
				else: # knot was already multilanguage
					var newblock:Dictionary={}
					for lang in Autoload.languages:
						if theknot[bloc]["text"].has(lang):newblock[lang]=theknot[bloc]["text"][lang]
						else: newblock[lang]="<<translation>>"
					theknot[bloc]["text"]=newblock
					for oldlang in theknot[bloc]["text"].keys():
						if not Autoload.languages.has(oldlang):theknot[bloc]["text"].erase(oldlang)
			if theknot[bloc]["type"]=="condition":
				var newconsequences:=[]
				for cons in theknot[bloc]["consequences"]:
					if cons is Dictionary and cons.get("type", "") == "choice":
						var conditional_choice: Dictionary = cons
						var localized_choice_text: Dictionary = {}
						for lang in Autoload.languages:
							if conditional_choice.get("text", {}) is Dictionary and conditional_choice["text"].has(lang): localized_choice_text[lang] = conditional_choice["text"][lang]
							else: localized_choice_text[lang] = "<<translation>>"
						conditional_choice["text"] = localized_choice_text
						var normalized_choice_consequences := []
						for choice_consequence in conditional_choice.get("consequences", []):
							if choice_consequence is Dictionary:
								var localized_choice_consequence: Dictionary = {}
								for lang in Autoload.languages:
									if choice_consequence.has(lang): localized_choice_consequence[lang] = choice_consequence[lang]
									else: localized_choice_consequence[lang] = "<<translation>>"
								normalized_choice_consequences.push_back(localized_choice_consequence)
							else: normalized_choice_consequences.push_back(choice_consequence)
						conditional_choice["consequences"] = normalized_choice_consequences
						newconsequences.push_back(conditional_choice)
					elif cons is Dictionary: # text to display
						var newblock:Dictionary={}
						for lang in Autoload.languages:
							if cons.has(lang): newblock[lang]=cons[lang]
							else: newblock[lang]="<<translation>>"
						newconsequences.push_back(newblock)
					else:newconsequences.push_back(cons)
				theknot[bloc]["consequences"]=newconsequences
		if not $inkminconverter.save_dict_to_json_file(theknot,Autoload.jsonfolder+knot+".json"):
			return
	warning("All jsons now include new language data","black")

func chooselang (lang) -> void:
	if lang == Autoload.currentlang:
		if lang == Autoload.mainlang: %mainlang.set_pressed_no_signal(true)
		return
	if knotchanged:
		popup("The text was changed. Save json first?",true)
		var answer=await yesornoanswer
		if answer=="yes":
			savejson()
			if knotchanged:return
		elif answer=="no":
			displayeditor()
	Autoload.currentlang=lang
	resetlangmenu()
	# display
	if knotname!="root":
		_on_play_pressed()
		displayeditor()

func _on_managelang_pressed() -> void:
	if Autoload.jsonfolder=="":return
	%Languagemanager.show()

