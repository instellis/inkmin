# export all jsons into an inkfile
func _on_export_pressed() -> void:
	var inkfile:=[]
	$inkminconverter.inkarray.clear()
	var alltheknots:=[]
	for knot in Autoload.allknots:
		if knot.length()>0:alltheknots.push_back(knot)
	# iterate through all knots
	for knot in alltheknots:
		var jsoncontent:Dictionary=$inkminconverter.load_json_file(Autoload.jsonfolder+knot+".json")
		if knot=="root":
			inkfile.push_back("=== root ===\n")
			if jsoncontent["root"].has("languages"):
				var langlist:="# LANG="
				for lang in jsoncontent["root"]["languages"]: langlist+=lang+","
				if langlist.strip_edges().ends_with(","):langlist=langlist.trim_suffix(",")
				inkfile.push_back(langlist+"\n")
			if jsoncontent["root"].has("groups"):
				for group in jsoncontent["root"]["groups"]:
					var group_knots := ""
					if group.has("knots"):
						group_knots = ",".join(group["knots"])
					var groupcolor:=normalizegroupcolor(group.get("color",defaultgroupcolor()))
					inkfile.push_back("# GROUP="+str(group.get("name",""))+"|"+group_knots+"|"+groupcolor+"\n")
			for item in jsoncontent["root"]["variables"]:
				inkfile.push_back($inkminconverter.inkvariableline(str(item.name), item.content)+"\n")
			if jsoncontent["root"].has("next"):
				var firstknot:String=jsoncontent[jsoncontent["root"]["next"]]["destination"]
				inkfile.push_back("-> "+str(firstknot))
			inkfile.push_back("\n")
		else:
			var newknot:Array=$inkminconverter.jsontoink(knot,jsoncontent)
			if newknot.size()<2:
				print("error: converted knot "+ knot + "is empty"); return
			for line in newknot:
				inkfile.push_back(line)
	# inkfile now contains the whole content, line by line, as an array
	$inkminconverter.inkarray=inkfile

	# now save inkfile array into ink file
	%filedialog.title=tr("Save a File")
	%filedialog.filename_filter=""
	%filedialog.filters=[]
	%filedialog.file_mode=FileDialog.FILE_MODE_SAVE_FILE
	filedialogmission="saveink"
	open_filedialog("save")

