	filedialogmission=mission
	open_filedialog("select")

func _on_filedialog_file_selected(path: String) -> void:
	%filedialog.hide()
	match filedialogmission:
		"loadjson":
			if path.get_file() != "root.json":
				popup("Please select root.json")
				return
			Autoload.jsonfolder=path.trim_suffix("root.json")
			%folderpath.text=path.trim_suffix("root.json")
			Autoload.jsonfolder=path.trim_suffix("root.json")
			knotname="root"
			initiateknot()
			Autoload.dialogsdir=path.get_base_dir()
			Autoload.save_settings()
		"choosedir":
			Autoload.jsonfolder=path+"/"
			%folderpath.text=path+"/"
		"choosedirnewproject":
			clearall()
			Autoload.jsonfolder=path+"/"
			%folderpath.text=path+"/"
			createnewknot("root")
		"loadink":
			$inkminconverter.convertinkfile(path,Autoload.jsonfolder)
		"saveink":
			$inkminconverter.save_array_to_file($inkminconverter.inkarray,path)
			warning("Ink file saved.","black")
	filedialogmission=""

func loadrootdata() ->void:
	if Autoload.jsonfolder.length()<2:
		warning("Missing a json folder to load root data.") ; return
	Autoload.rootknot=$inkminconverter.load_json_file(Autoload.jsonfolder+"root.json")
	if Autoload.rootknot.size()<1:
		warning("Json root data is empty.") ; return
	# initiate game variables, list of knots and languages
	if Autoload.rootknot["root"].has("knots"): Autoload.allknots=Autoload.rootknot["root"]["knots"]
	if Autoload.rootknot["root"].has("languages"): Autoload.languages=Autoload.rootknot["root"]["languages"]
	if Autoload.rootknot["root"].has("groups"):Autoload.knotgroups=normalizeknotgroups(Autoload.rootknot["root"]["groups"])

