func createnewknot(newknotname) -> void:

	if newknotname=="":return

	# cleanup existing	
	Autoload.allknots.erase(knotname)
	%inktext.clear()

	# make new
	knotname=newknotname
	makeknotbutton(newknotname)
	highlightknot()
	if not Autoload.allknots.has(newknotname):Autoload.allknots.push_back(newknotname)

	%inktext.insert_line_at(%inktext.get_caret_line(),"=== "+knotname+" ===\n")

	if knotname=="root":
		%inktext.insert_line_at(%inktext.get_caret_line(),"# LANG=en")
		%inktext.insert_line_at(%inktext.get_caret_line(),"# VAR thevariable = 0.0")
		%inktext.insert_line_at(%inktext.get_caret_line(),"// -> firstknotname")

	savejson()

func makeknotbutton(newknotname,parentnode=%knotlist)-> void:
	if newknotname=="":
		Autoload.allknots.erase("") ; return
	var knotbutton:=%knotlist/model.duplicate()
	knotbutton.get_node("knot").text=newknotname ; knotbutton.show()
	knotbutton.get_node("knot").connect("pressed",Callable(self,"chooseknot").bind(newknotname))
	if newknotname!="root":
		knotbutton.get_node("up").connect("pressed",Callable(self,"arrangeknots").bind(knotbutton,"up"))
		knotbutton.get_node("down").connect("pressed",Callable(self,"arrangeknots").bind(knotbutton,"down"))
		knotbutton.get_node("erase").connect("pressed",Callable(self,"arrangeknots").bind(knotbutton,"delete"))
	else: 
		knotbutton.get_node("up").hide() ; knotbutton.get_node("down").hide(); knotbutton.get_node("erase").hide()
	knotbutton.set_meta("name",newknotname)
	knotbutton.set_meta("drag_type","knot")
	knotbutton.get_node("knot").add_to_group("knotbuttons")
	$UI.setup_knot_list_drag(knotbutton)
	parentnode.add_child(knotbutton,true) ; knotbutton.name="knotbutton"

func normalizeknotgroups(groups:Array) -> Array:
	var normalizedgroups:=[]
	for group in groups:
		if not group is Dictionary:
			continue
		var groupname:=str(group.get("name","")).strip_edges()
		if groupname=="":
			continue
		var groupknots:=[]
		var rawknots=group.get("knots",[])
		if rawknots is Array:
			for knot in rawknots:
				groupknots.push_back(str(knot))
		normalizedgroups.push_back({
			"name": groupname,
			"knots": groupknots,
			"collapsed": bool(group.get("collapsed", false)),
			"color": normalizegroupcolor(group.get("color", defaultgroupcolor()))
		})
	return normalizedgroups

func groupcolorpalette() -> Array:
	const PALETTE := ["#92BFE9", "#8FD3B5", "#F2C879", "#EE9A9A", "#C9A7E8", "#A7B8D8"]
	return PALETTE

func defaultgroupcolor() -> String:
	return groupcolorpalette()[0] # The original group-header blue.

func normalizegroupcolor(colorvalue) -> String:
	var colorstring:=str(colorvalue).to_upper()
	if groupcolorpalette().has(colorstring): return colorstring
	return defaultgroupcolor()

func applygroupcolor(thegroup:PanelContainer, colorvalue) -> void:
	var groupcolor:=normalizegroupcolor(colorvalue)
	thegroup.set_meta("color",groupcolor)
	thegroup.get_node("VBox/menu").modulate=Color.html(groupcolor)

func setgroupcollapsed(thegroup:PanelContainer, collapsed:bool) -> void:
	thegroup.set_meta("collapsed",collapsed)
	thegroup.get_node("VBox/knots").visible=not collapsed
	thegroup.get_node("VBox/menu/VBox/collapse").text=" + " if collapsed else " - "

func saveknots()->void: # called by savetimer to save all
	rebuildknots()
	saveasked=false
	var rootcontent:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
	rootcontent.root.groups=Autoload.knotgroups
	rootcontent.root.knots=Autoload.allknots
	if not $inkminconverter.save_dict_to_json_file(rootcontent,Autoload.jsonfolder+"root.json"):
		knotchanged=true
		return
	$inkminreader.allknots=Autoload.allknots.duplicate()

func _on_knot_list_reordered() -> void:
	if saveasked == false:
		saveasked = true
		savetimer.start(1)

# create a selectable list of knots
func resetknotlist() -> void:

	for item in %knotlist.get_children():
		if not "model" in item.name:item.queue_free()
	if not Autoload.allknots.has("root"):Autoload.allknots.push_back("root")
	if not Autoload.allknots.has(knotname):Autoload.allknots.push_back(knotname)

	# create knot dictionary including groups
	var createdgroups:=[]
	for knot in Autoload.allknots:
		var hasgroup:=false
		# look for group
		for group in Autoload.knotgroups:
			if knot in group.knots:
				hasgroup=true
				if not group.name in createdgroups: # create group
					createdgroups.push_back(group.name)
					var newgroup:=%knotlist/groupmodel.duplicate()
					newgroup.get_node("VBox/menu/VBox/groupname").text=group.name
					newgroup.name=group.name ; newgroup.set_meta("name",group.name)
					newgroup.set_meta("drag_type","group")
					newgroup.set_meta("collapsed",bool(group.get("collapsed",false)))
					applygroupcolor(newgroup,group.get("color",defaultgroupcolor()))
					newgroup.get_node("VBox/menu/VBox/up").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"up"))
					newgroup.get_node("VBox/menu/VBox/down").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"down"))
					newgroup.get_node("VBox/menu/VBox/change").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"change"))
					newgroup.get_node("VBox/menu/VBox/collapse").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"collapse"))
					newgroup.get_node("VBox/menu/VBox/erase").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"delete"))
					$UI.setup_knot_list_drag(newgroup)
					%knotlist.add_child(newgroup) ; newgroup.show()
					setgroupcollapsed(newgroup,bool(group.get("collapsed",false)))
					makeknotbutton(knot,newgroup.get_node("VBox/knots"))
					break
				else: # group already exists
					makeknotbutton(knot,%knotlist.get_node(group.name+"/VBox/knots"))
					break
		if not hasgroup: makeknotbutton(knot,%knotlist)

# left menu buttons for navigating knots
func chooseknot(knot)->void:

	if knot==knotname:return

	# user made changes in editor
	if knotchanged:
		popup("The text was changed. Save json first?",true)
		var answer=await yesornoanswer
		if answer=="yes": 
			savejson()
