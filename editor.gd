extends Control

# Main editor script
# UI helper functions are in UI.gd

var knotname:="": 
	set(value):
		knotname=value
		%knotname.text=value
		if value!="": highlightknot()
var knotchanged:=false : 
	set(value):
		knotchanged=value
		if value==true:
			%save.show()
			%save.modulate=Color.LIGHT_PINK
		else:
			%save.hide()
			%save.modulate=Color.WHITE
var knotarray:=[]
var knotgroups:=[] # [{"rank":0,"name":"xxx","knots":[x,y,z]}]
var gameplaystack:=[] # stack with feed generated by inkminreader 
var gamestackpaused:=false
var displaying:=false
var filedialogmission:=""
var linebreak:=true
var saveasked:=false
var savetimer:=Timer.new()

signal yesornoanswer

func _ready() -> void:
	setup_editor_window()
	Autoload.editornode=self
	add_child(savetimer) ; savetimer.one_shot=true
	savetimer.connect("timeout",saveknots)
	$UI.knot_list_reordered.connect(_on_knot_list_reordered)
	$inkminreader.connect("inkminfeed",inkminfeed)
	$inkminconverter.connect("conversionfinished",conversionfinished)
	$inkminconverter.connect("parserwarning",Callable(self,"warning").bind("red"))
	%filedialog.connect("file_selected",Callable(%Languagemanager.fileselected))
	%filedialog.connect("dir_selected",Callable(%Languagemanager.fileselected))
	%Languagemanager.thefiledialog=%filedialog
	%help_popup.get_ok_button().hide()
	%langmenu.item_selected.connect(_on_translation_language_selected)
	%linebreak.button_pressed=true
	Autoload.load_settings()
	TranslationServer.set_locale(Autoload.editorlang)
	resetlangmenu()
	$UI.apply_font_settings()
	$UI.highlight_lines()

func setup_editor_window() -> void:
	DisplayServer.window_set_min_size(Vector2i(1920, 1080))
	var usable_rect:Rect2i = DisplayServer.screen_get_usable_rect()
	var target_size:=Vector2i(1920, 1080)
	DisplayServer.window_set_size(target_size)
	DisplayServer.window_set_position(usable_rect.position + ((usable_rect.size - target_size) / 2))

# ----------------
#  game simulator
# ----------------

func _input(event: InputEvent) -> void:
	if %OKmodel.visible and event.is_action_pressed("mouse_right"):
		_on_continue_pressed()

	elif knotchanged and event.is_action_pressed("savejson"):
		savejson()

func _physics_process(_delta: float) -> void:

	if gameplaystack.size()==0:return
	if gamestackpaused: return
	
	var block:Dictionary=gameplaystack[0]

	if block.has("text"): # block.text contains the text to display
		gameplaystack.remove_at(0)
		var textbox:=%gamedisplay/textmodel.duplicate()
		textbox.name="textbox"
		textbox.text=block.text ; textbox.show()
		%gamedisplay.add_child(textbox)
		# stops after displaying line if this option is chosen 
		if linebreak:
			if not gameplaystack.is_empty() and not gameplaystack[0].has("choice"): 
				gamestackpaused=true
				%OKmodel.show() ; %OKmodel.get_parent().move_child(%OKmodel,%OKmodel.get_parent().get_child_count()-1)

	elif block.has("choice"):
		gameplaystack.remove_at(0)
		var textbutton:=%gamedisplay/buttonmodel.duplicate()
		textbutton.name="choicebutton"
		textbutton.connect("pressed",Callable($inkminreader,"choicemade").bind(block.next, block.get("blocid", "")))
		textbutton.text=block.choice ; textbutton.show()
		%gamedisplay.add_child(textbutton)

	elif block.has("signal"):
		gameplaystack.remove_at(0)
		var textbox:=%gamedisplay/textmodel.duplicate()
		textbox.self_modulate=Color.LIGHT_BLUE
		textbox.text="# "+block.signal ; textbox.show()
		%gamedisplay.add_child(textbox)
	
	elif block.has("newknot"):
		gameplaystack.remove_at(0)
		# clean up game console
		for item in %gamedisplay.get_children(): 
			if not "model" in item.name:item.queue_free()
		# editor stuff
		knotname=block.newknot # update editor data
		displayeditor() # refresh ink-type editor

func inkminfeed(block) -> void:

	# receives output from inkmin and does something with it 

	if block.has("text"): gameplaystack.push_back(block)

	elif block.has("choice"): gameplaystack.push_back(block)
		# output.choicetext contains the choice to display
		# once the choice is made, call $inkminreader.choicemade(output.next)
	
	elif block.has("choicemade"):
		# clean up game console
		for item in %gamedisplay.get_children(): 
			if not "model" in item.name:item.queue_free()

	elif block.has("signal"): gameplaystack.push_back(block)
		# output.signal contains the tag sent by the narrative file

	elif block.has("varchange"):
		# output.varchange contains the name of the variable that was changed
		
		# change variables in editor display %varbox
		displayvariables()

	elif block.has("newknot"):
		# a new dialog knot has been loaded, decide what to do
		gameplaystack.push_back(block)
		
# play the game simulation
func _on_play_pressed() -> void:
	gameplaystack.clear() ; gamestackpaused=false
	for item in %gamedisplay.get_children(): 
		if not "model" in item.name:item.queue_free()
	$inkminreader.loadandstartknot(knotname)

func _on_linebreak_pressed() -> void:
	linebreak=%linebreak.button_pressed
	if linebreak:_on_play_pressed()

func _on_continue_pressed() -> void:
	%OKmodel.hide()
	for item in %gamedisplay.get_children():
		if not "model" in item.name:item.queue_free()
	gamestackpaused=false

