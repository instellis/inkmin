func popup(message:="",yesno:=false, linedit:=false)->void:
	if yesno==true:%yesorno.show()
	else:%yesorno.hide()
	if linedit==true:
		%lineedit.text="" ; %lineedit.show()
	else: %lineedit.hide()
	%popupmessage.text=message
	%Popup.show()

func warning(message:="", color:="red")->void:
	%warnings.append_text("[color="+color+"]"+message+"[/color]"+"\n")

func close_popup()->void:
	%Popup.hide()

func yesnopopup(answer)->void:
	%Popup.hide()
	yesornoanswer.emit(answer)

# ------------------------
# ink style editor display

func is_translation_editor_mode() -> bool:
	return knotname != "root" and Autoload.currentlang != Autoload.mainlang

func set_editor_mode_ui(translation_mode: bool) -> void:
	%inktext.visible = not translation_mode
	%translationview.visible = translation_mode
	var editmenu:Control = %menu
	for item in editmenu.get_children():
		if item is Button and item != %save:
			item.disabled = translation_mode
	if translation_mode and not knotchanged:
		%save.hide()

func displayeditor() ->void: # displays inkmin language content in text editor

	set_editor_mode_ui(is_translation_editor_mode())
	if Autoload.currentlang==Autoload.mainlang:%inktext.editable=true
	else: %inktext.editable=false

	if knotname=="root":
		%inktext.visible = true
		%translationview.hide()
		displayroot()
		return

	if Autoload.currenteditorknot.is_empty() or not knotchanged:
		Autoload.currenteditorknot=$inkminreader.load_json_file(Autoload.jsonfolder+knotname+".json")
	Autoload.sortededitorknot=$inkminreader.sortknot(Autoload.currenteditorknot)
	
	displaying=true ; knotchanged=false
	if is_translation_editor_mode():
		%translationview.displaytranslationeditor(knotname)
		displaying=false
		return
	%inktext.text="=== "+knotname+" ==="+"\n\n"
	var suffixes:={"goto":"-> ","signal":"# ","text":"","choice":"+ ","weave":"- ","execute":"~ ","root":"","condition":"","comment":"// ","stitch":"= "}
	for sortedbloc in Autoload.sortededitorknot:
		var bloc=Autoload.currenteditorknot[sortedbloc.key]
		var suffix:String=suffixes[bloc.type]
		match bloc.type:
			"root":
				if bloc.has("variables"):
					for variable in bloc.variables:
						%inktext.text+="VAR "+variable.name+" = "+str(variable.content)+"\n"
			"goto":
				for i in bloc.choicerank:suffix=suffix.indent("\t")
				%inktext.text+=suffix+str(bloc.destination) +"\n"
			"signal":
				for i in bloc.choicerank:suffix=suffix.indent("\t")
				%inktext.text+=suffix+str(bloc.instruction) +"\n"
			"comment":
				for i in bloc.choicerank:suffix=suffix.indent("\t")
				%inktext.text+=suffix+str(bloc.comtext) +"\n"
			"text":
				var thetext:String
				if bloc.text is Dictionary:thetext=bloc.text[Autoload.currentlang]
				else:thetext=bloc.text
				for i in bloc.choicerank:thetext=thetext.indent("\t")
				%inktext.text+=thetext +"\n"
			"choice":
				var thetext:String
				if bloc.text is Dictionary: thetext = bloc.text[Autoload.currentlang]
				else: thetext = bloc.text
				# build + prefix (structure)
				var prefix := ""
				for i in bloc.choicerank: prefix += "+"
				# build indentation (visual)
				var indent := ""
				for i in bloc.choicerank - 1: indent += "\t"
				%inktext.text += "\n" + indent + prefix + " " + str(thetext) + "\n"
			"weave":
				for i in bloc.choicerank:suffix=suffix.indent("\t")
				var thetext:String
				if bloc.text is Dictionary:thetext=bloc.text[Autoload.currentlang]
				else:thetext=bloc.text
				%inktext.text+="\n"+suffix+str(thetext) +"\n"
			"execute":
				for i in bloc.choicerank:suffix=suffix.indent("\t")
				%inktext.text+=suffix+str(bloc.instruction) +"\n"
			"stitch":
				%inktext.text+="\n= "+str(bloc.name)+"\n"
			"condition":
				var conditiontext:="{"+str(bloc.condition)+":"
				var has_conditional_choice := false
				for consequence in bloc.consequences:
					if consequence is Dictionary and consequence.get("type", "") == "choice":
						has_conditional_choice = true
						break
				if bloc.consequences.size()>1 or has_conditional_choice:
					for cons in bloc.consequences:
						if cons is Dictionary and cons.get("type", "") == "choice":
							var conditional_choice_text = cons.get("text", "")
							if conditional_choice_text is Dictionary:
								conditional_choice_text = conditional_choice_text.get(Autoload.currentlang, "")
							conditiontext += "\n\t+ " + str(conditional_choice_text)
							for choice_consequence in cons.get("consequences", []):
								if choice_consequence is Dictionary:
									choice_consequence = choice_consequence.get(Autoload.currentlang, "")
								conditiontext += "\n\t\t" + str(choice_consequence)
						else:
							if cons is Dictionary:
								cons=cons[Autoload.currentlang]
							conditiontext+="\n"+str(cons)
					conditiontext+="\n}" +"\n"
				else:
					var theconsequence=bloc.consequences[0]
					if theconsequence is Dictionary: 
						theconsequence=theconsequence[Autoload.currentlang]
					conditiontext+=str(theconsequence)+"}" +"\n"
				for i in bloc.choicerank:conditiontext=conditiontext.indent("\t")
				%inktext.text+=conditiontext.replace("[\"","").replace("\"]","").replace("\\", "")
	$UI.highlight_lines()
	buildknotarray()
	displaying=false
	
func buildknotarray()->void:
	knotarray.clear()
	for line in %inktext.get_line_count():knotarray.push_back(%inktext.get_line(line))

# display root node in editor
func displayroot()->void:
	knotname="root"
	# clean up
	for item in %gamedisplay.get_children(): 
		if not "model" in item.name:item.queue_free()
	%inktext.text="=== root ===\n"
	# display languages
	var rootblock:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
	if rootblock.size()==0:
		warning("Empty root json!","red") ; return
	if not rootblock["root"].has("languages"): rootblock["root"]["languages"]=["en"] # needs default language
	var langlist=rootblock["root"]["languages"]
	var langtext:="# LANG= "
	if langlist is Array and langlist.size()>0:
		for lang in langlist: langtext+=str(lang)+","
	if langtext.ends_with(","):langtext=langtext.strip_edges().trim_suffix(",")
	%inktext.text+=langtext+"\n"
	resetlangmenu()
	# display variables
	if rootblock["root"].has("variables"):
		for item in rootblock["root"]["variables"]:
			if item.content is String and item.content=="":item.content="\"\""
			%inktext.text+="# VAR "+str(item.name)+" = "+str(item.content)+"\n"
	# Display root flow blocks in their original line order.
	for sorted_block in $inkminreader.sortknot(rootblock):
		var block:Dictionary=rootblock[sorted_block.key]
		if block.type=="comment":
			%inktext.text+="// "+str(block.comtext)+"\n"
		elif block.type=="goto":
			%inktext.text+="-> "+str(block.destination)+"\n"
	$UI.highlight_lines()
	reloadplayervarsfromroot(rootblock)

func reloadplayervarsfromroot(rootblock:Dictionary={}) -> void:
	var sourceroot:=rootblock
	if sourceroot.is_empty():
		sourceroot=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
	$inkminreader.playervars.clear()
	if sourceroot.is_empty():
		return
	if sourceroot.has("root") and sourceroot["root"].has("variables"):
		for item in sourceroot["root"]["variables"]:
			var varcontent=item.content
			if varcontent is String and varcontent=="\"\"":
				varcontent=""
			if str(item.name).strip_edges()!="":
				$inkminreader.playervars[item.name]=varcontent

# create variables in game display
func displayvariables()->void:
	var activevars := []
	for item in $inkminreader.playervars:
		activevars.push_back(str(item))
	for child in %varbox.get_children():
		if child.name == "model":
			continue
		if not activevars.has(child.name):
			child.queue_free()
	for item in $inkminreader.playervars:
		if str(item).strip_edges()=="":
			continue
		# create if does not exist
		if not %varbox.get_children().map(func(c): return c.name).has(item):
			var display:=%varbox/model.duplicate()
			display.name=item
			display.get_node("name").text=item
			var content:LineEdit=display.get_node("content")
			content.text=str($inkminreader.playervars[item])
			content.focus_exited.connect(Callable(self,"commit_variable_edit").bind(str(item), content))
			content.text_submitted.connect(Callable(self,"submit_variable_edit").bind(str(item), content))
			display.show() ; %varbox.add_child(display)
		# update if exists
		else: 
			%varbox.get_node(item+"/content").text=str($inkminreader.playervars[item])

func submit_variable_edit(_new_value: String, variable_name: String, field: LineEdit) -> void:
	commit_variable_edit(variable_name, field)

func commit_variable_edit(variable_name: String, field: LineEdit) -> void:
	if not $inkminreader.playervars.has(variable_name):
		return
	$inkminreader.playervars[variable_name]=parse_variable_editor_value(field.text)
	$inkminreader.inkminfeed.emit({"varchange":variable_name})

func parse_variable_editor_value(value: String):
	var clean_value:=value.strip_edges()
	var is_quoted_string:=clean_value.length()>=2 and clean_value.begins_with("\"") and clean_value.ends_with("\"")
	if is_quoted_string:
		return clean_value.trim_prefix("\"").trim_suffix("\"")
	if clean_value.to_lower()=="true":
		return true
	if clean_value.to_lower()=="false":
		return false
	if clean_value.is_valid_int():
		return clean_value.to_int()
	if clean_value.is_valid_float():
		return clean_value.to_float()
	return clean_value

func resetvariables() -> void:
	for item in $inkminreader.playervars:
		var thevar=$inkminreader.playervars[item]
		if thevar is int: $inkminreader.playervars[item]=0
		elif thevar is float: $inkminreader.playervars[item]=0
		elif thevar is bool: $inkminreader.playervars[item]=false
		elif thevar is String: $inkminreader.playervars[item]=""
	displayvariables()

# triggered by user action in the editor text zone
func _on_editor_gui_input(event: InputEvent) -> void:
	if displaying:return # not relevant if changes made by code
	
	if event is InputEventKey and not Autoload.allknots.has("root"):
		popup("You need to create or load a project first")
		return
	
	if event is InputEventKey and event.pressed:
		if not %inktext.get_caret_line()==0:knotchanged=true

		if event.keycode == KEY_ENTER or event.keycode == KEY_KP_ENTER:
			# linebreak inserted at line number %inktext.get_caret_line()
			var lineconcerned:String= %inktext.get_line(%inktext.get_caret_line()).strip_edges()
			safetychecks(lineconcerned,%inktext.get_caret_line())

		if event.keycode == KEY_DELETE or event.keycode == KEY_BACKSPACE:
			if %inktext.get_line_count()!=knotarray.size():
				#print("deleted a line")
				buildknotarray()

# avoid all changes to first line (knot name)
func _on_inktext_text_changed() -> void:
	if knotname!="": %inktext.set_line(0, "=== "+knotname+" ===")
	else: %inktext.set_line(0,"")
	$UI.highlight_lines()

func normalizelangarray(langarray:Array) -> Array:
	var normalized:=[]
	for item in langarray:
		var lang:=str(item).strip_edges()
		if lang=="":
			continue
		if not normalized.has(lang):
			normalized.push_back(lang)
	return normalized

func getcurrentrootlanguages() -> Array:
	if Autoload.jsonfolder.length() > 1:
		var rootcontent:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
		if rootcontent.has("root") and rootcontent["root"].has("languages"):
			return normalizelangarray(rootcontent["root"]["languages"])
	return normalizelangarray(Autoload.languages)

func safetychecks(lineconcerned,linenb) -> void:

	# root node specific limitations
	if knotname=="root":
		if lineconcerned.begins_with("var"): 
			lineconcerned=lineconcerned.replace("var","VAR")
			%inktext.set_line(linenb,lineconcerned)
			%inktext.set_caret_line(linenb) ;%inktext.set_caret_column(lineconcerned.length())
		elif linenb>0 and not (lineconcerned.begins_with("VAR") or lineconcerned.begins_with("# VAR") or lineconcerned.begins_with("->") or lineconcerned.begins_with("# LANG=") or lineconcerned.begins_with("//")):
			warning("Root node should only contain # VAR, # LANG, // and ->")
			%inktext.set_line_background_color(linenb,Color.LIGHT_CORAL)
		elif lineconcerned.begins_with("VAR"):
			var correctedvarline:String="# "+lineconcerned
			%inktext.set_line(linenb,correctedvarline)
			%inktext.set_caret_line(linenb) ;%inktext.set_caret_column(correctedvarline.length())
		elif lineconcerned.begins_with("# LANG="):
			var langlist:String=lineconcerned.trim_prefix("# LANG=")
			var langarray:=normalizelangarray(Array(langlist.split(",")))
			var currentlangs:=getcurrentrootlanguages()
			if Autoload.jsonfolder.length()<2:
				popup("You need to chose a folder for your jsons first")
				return
			if langarray==currentlangs:
				return
			popup("Are you sure you want to change languages?",true)
			var answer=await yesornoanswer
			if answer=="no":
				var currentlangline:="# LANG="+",".join(currentlangs)
				%inktext.set_line(linenb,currentlangline)
				%inktext.set_caret_line(linenb)
				%inktext.set_caret_column(currentlangline.length())
				return
			else:
				Autoload.languages=langarray
				resetlangmenu()
				displayroot()
				changelanguages()
		else: %inktext.set_line_background_color(linenb,Color.WHITE)

	buildknotarray()

func initiateknot()-> void: # called after loading jsons

	loadrootdata()
	$inkminreader.initiatedialogs()
	$inkminreader.currentlang=$inkminreader.languages[0]
	Autoload.mainlang=$inkminreader.languages[0] ; Autoload.currentlang=$inkminreader.languages[0]
	$inkminreader.loadandstartknot("root")
	displayvariables()
	resetlangmenu()
	resetknotlist()
	displayeditor()

func _on_newproject_pressed() -> void:
	if Autoload.allknots.size()>0:
		popup("Are you sure you want to create a new project",true)
		var answer=await yesornoanswer
		if answer=="yes": pass
		else: return

	choosedir("Choose a folder for the json files","choosedirnewproject")

# change knot name
func _on_knotchange_clicked() -> void:
	if %knotname.text=="" or %knotname.text=="root":return
	popup("Type in a new name for the knot:",true,true)
	%lineedit.text=knotname
	var answer=await yesornoanswer
	if answer=="yes":
		var newknotname=%lineedit.text
		if newknotname!=knotname:
			if newknotname in Autoload.allknots:
				warning("There is allready a knot with this name")
				return
			else:
				# change knot name in knot list panel and editor
				var correctedline:String="=== "+newknotname+" ===\n"
				%inktext.set_line(0,correctedline)
				for item in %knotlist.get_children():
					if "model" in item.name:pass
					elif item is PanelContainer: # item is a group of knots
						for knot in item.get_node("VBox/knots").get_children(): 
							if knot.get_meta("name")==knotname: 
								knot.set_meta("name",newknotname)
								var btn = knot.get_node("knot")
								btn.text=newknotname
								if btn.is_connected("pressed", Callable(self, "chooseknot")): 
									btn.disconnect("pressed", Callable(self, "chooseknot"))
								btn.connect("pressed", Callable(self, "chooseknot").bind(newknotname))
								break
					else:  # item is a knot without group
						if item.get_meta("name")==knotname:
							item.set_meta("name",newknotname)
							var btn = item.get_node("knot")
							btn.text=newknotname
							if btn.is_connected("pressed", Callable(self, "chooseknot")): 
								btn.disconnect("pressed", Callable(self, "chooseknot"))
							btn.connect("pressed", Callable(self, "chooseknot").bind(newknotname))
							break
				# change knot name in data variables
				for group in Autoload.knotgroups:
					if group.knots.has(knotname):
						var ind=group.knots.find(knotname)
						group.knots.set(ind,newknotname)
				var ind=Autoload.allknots.find(knotname)
				Autoload.allknots.set(ind,newknotname)
				Autoload.knotname=newknotname
				# erase existing json
				if FileAccess.file_exists(Autoload.jsonfolder+knotname+".json"):
					DirAccess.remove_absolute(Autoload.jsonfolder+knotname+".json")
				else: warning ("could not erase json bearing old name")
				knotname=newknotname
				# rebuild root json and save root and json
				var rootcontent:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
				if rootcontent.is_empty():
					warning("failed to load root json")
					return
				rootcontent.root["groups"]=Autoload.knotgroups
				rootcontent.root["knots"]=Autoload.allknots
				knotchanged=true
				if not $inkminconverter.save_dict_to_json_file(rootcontent,Autoload.jsonfolder+"root.json"):
					return
				savejson()
				if knotchanged:return
				warning("New knot name saved: "+str(knotname),"black")

# clear everything
func clearall()->void:
	gameplaystack.clear() ; gamestackpaused=false
	Autoload.allknots.clear()
	knotname="" ; Autoload.jsonfolder="" ; knotchanged=false
	%inktext.text="" ; %folderpath.text=""
	Autoload.languages=["en"] ; Autoload.mainlang="en" ; Autoload.currentlang="en"
	Autoload.resetdata()
	%OKmodel.hide()
	resetlangmenu()
