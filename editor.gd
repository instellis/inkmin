func highlightknot():
	for aknot in get_tree().get_nodes_in_group("knotbuttons"):
		if aknot.text!=knotname:aknot.button_pressed=false
		else: aknot.button_pressed=true

# rearrange knot order or delete knot
func arrangeknots(theknot:HBoxContainer, operation:String) -> void:
	var knotposition=theknot.get_parent().get_children().find(theknot)
	if theknot.get_parent()==%knotlist and theknot.get_meta("name","")=="root":return # never touch root knot
	var newposition:int=knotposition
	match operation:
		"delete":
			popup("Are you sure you want to delete this knot",true)
			var answer = await yesornoanswer
			if answer =="no":return
			else: 
				# erase existing json
				if FileAccess.file_exists(Autoload.jsonfolder+knotname+".json"):
					DirAccess.remove_absolute(Autoload.jsonfolder+knotname+".json")
					warning ("erased json for knot: "+str(knotname),"black")
				else: warning ("could not erase json for knot: "+str(knotname))
				if knotname==theknot.get_meta("name"):
					knotname="" ; %inktext.clear()
				theknot.queue_free()
		"up":	newposition-=1
		"down":	newposition+=1
	
	if operation=="up" or operation=="down":
		if theknot.get_parent()==%knotlist: # knot is currently not in a group
			if newposition<$UI.get_knot_list_first_movable_index():newposition=$UI.get_knot_list_first_movable_index() # never replace rootnode
			elif newposition==%knotlist.get_child_count():newposition=%knotlist.get_child_count()-1
			# check if next position is a group and insert it
			if %knotlist.get_child(newposition) is PanelContainer: # new position is a group
				var targetgroup := %knotlist.get_child(newposition) as PanelContainer
				var collapsed:=bool(targetgroup.get_meta("collapsed"))
				if collapsed:
					theknot.get_parent().move_child(theknot,newposition if operation=="up" else newposition+1)
				else:
					%knotlist.remove_child(theknot)
					targetgroup.get_node("VBox/knots").add_child(theknot,true)
					if operation=="down":
						targetgroup.get_node("VBox/knots").move_child(theknot,0)
			else: theknot.get_parent().move_child(theknot,newposition) # move within ungrouped list
		else: # knot is currently in a group
			var groupnode=theknot.get_parent().get_parent().get_parent()
			if newposition==-1: # knot leaves group upwards
				theknot.get_parent().remove_child(theknot)
				%knotlist.add_child(theknot,true) ; %knotlist.move_child(theknot,%knotlist.get_children().find(groupnode))
			elif newposition==theknot.get_parent().get_child_count(): # knot leaves group downwards
				theknot.get_parent().remove_child(theknot)
				%knotlist.add_child(theknot,true) ; %knotlist.move_child(theknot,%knotlist.get_children().find(groupnode)+1)
			else: theknot.get_parent().move_child(theknot,newposition) # move within group

	if saveasked==false: saveasked=true ; savetimer.start(1) # rebuild knot array autosave

func arrangegroups(thegroup:PanelContainer, operation:String) -> void:
	var groupposition=thegroup.get_index()
	var newposition:int=groupposition
	match operation:
		"collapse":
			setgroupcollapsed(thegroup,not bool(thegroup.get_meta("collapsed")))
		"change":
			await renamegroup(thegroup)
			return
		"delete":
			popup("Are you sure you want to delete this group",true)
			var answer = await yesornoanswer
			if answer =="no":return
			else:
				var counter:=0
				for item in thegroup.get_node("VBox/knots").get_children():
					item.get_parent().remove_child(item)
					%knotlist.add_child(item) ; %knotlist.move_child(item,groupposition+counter)
					counter+=1
				thegroup.queue_free()
		"up":	
			newposition=clamp(newposition-1,$UI.get_knot_list_first_movable_index(),%knotlist.get_child_count()-1)
			thegroup.get_parent().move_child(thegroup,newposition)
		"down":
			newposition=clamp(newposition+1,$UI.get_knot_list_first_movable_index(),%knotlist.get_child_count()-1)
			thegroup.get_parent().move_child(thegroup,newposition)

	if saveasked==false: saveasked=true ; savetimer.start(1) # rebuild knot arrays and autosave

func groupnameexists(groupname:String, excludedgroup:String="") -> bool:
	var cleanname:=groupname.strip_edges()
	for group in Autoload.knotgroups:
		if group.name == cleanname and group.name != excludedgroup:
			return true
	return false

func promptgroupname(titletext:String, initialtext:String, initialcolor:String, confirmaction:Callable) -> void:
	var dialog := AcceptDialog.new()
	dialog.title = tr(titletext) ; dialog.dialog_text = ""
	dialog.exclusive = true ; dialog.size = Vector2(300, 170)
	dialog.add_cancel_button(tr("Cancel"))
	var vbox := VBoxContainer.new() ; vbox.custom_minimum_size = Vector2(280, 125)
	dialog.add_child(vbox)
	var label := Label.new() ; label.text = tr("Name:")
	vbox.add_child(label)
	var name_input := LineEdit.new() ; name_input.name = "NameInput"
	name_input.placeholder_text = tr("Enter name here...")
	name_input.text = initialtext
	name_input.focus_mode = Control.FOCUS_ALL
	vbox.add_child(name_input)
	var colorlabel := Label.new() ; colorlabel.text = tr("Color:")
	vbox.add_child(colorlabel)
	var colorrow := HBoxContainer.new() ; colorrow.add_theme_constant_override("separation", 6)
	vbox.add_child(colorrow)
	var selectedcolor:=normalizegroupcolor(initialcolor)
	dialog.set_meta("selected_group_color",selectedcolor)
	var swatchgroup:=ButtonGroup.new()
	for colorvalue in groupcolorpalette():
		var swatch:=Button.new()
		swatch.custom_minimum_size=Vector2(28,28)
		swatch.tooltip_text=colorvalue
		swatch.toggle_mode=true ; swatch.button_group=swatchgroup
		var normalstyle:=StyleBoxFlat.new()
		normalstyle.bg_color=Color.html(colorvalue)
		normalstyle.corner_radius_top_left=4 ; normalstyle.corner_radius_top_right=4
		normalstyle.corner_radius_bottom_left=4 ; normalstyle.corner_radius_bottom_right=4
		normalstyle.border_width_left=1 ; normalstyle.border_width_top=1
		normalstyle.border_width_right=1 ; normalstyle.border_width_bottom=1
		normalstyle.border_color=Color(0.2,0.2,0.2)
		var selectedstyle:=normalstyle.duplicate()
		selectedstyle.border_width_left=3 ; selectedstyle.border_width_top=3
		selectedstyle.border_width_right=3 ; selectedstyle.border_width_bottom=3
		selectedstyle.border_color=Color.WHITE
		swatch.add_theme_stylebox_override("normal",normalstyle)
		swatch.add_theme_stylebox_override("hover",selectedstyle)
		swatch.add_theme_stylebox_override("pressed",selectedstyle)
		swatch.pressed.connect(Callable(self,"selectgroupdialogcolor").bind(dialog,colorvalue))
		colorrow.add_child(swatch)
		if colorvalue==selectedcolor: swatch.button_pressed=true
	dialog.get_ok_button().connect("pressed", func():
		var confirmedcolor:String=str(dialog.get_meta("selected_group_color",selectedcolor))
		confirmaction.call(name_input.text,confirmedcolor)
		dialog.queue_free())
	dialog.connect("canceled", func(): dialog.queue_free())

	get_tree().current_scene.add_child(dialog)
	dialog.popup_centered()
	await get_tree().process_frame
	name_input.grab_focus()
	name_input.select_all()

func selectgroupdialogcolor(dialog:AcceptDialog, colorvalue:String) -> void:
	dialog.set_meta("selected_group_color",colorvalue)

func renamegroup(thegroup:PanelContainer) -> void:
	var currentname:=str(thegroup.get_meta("name"))
	var currentcolor:=normalizegroupcolor(thegroup.get_meta("color",defaultgroupcolor()))
	await promptgroupname("Change group name", currentname, currentcolor, func(newname_raw,newcolor_raw):
		var newname:=str(newname_raw).strip_edges()
		var newcolor:=normalizegroupcolor(newcolor_raw)
		if newname=="":
			popup("Group name cannot be empty")
			return
		if newname==currentname and newcolor==currentcolor:
			return
		if groupnameexists(newname,currentname):
			popup("Group name already exists")
			return
		thegroup.name=newname
		thegroup.set_meta("name",newname)
		thegroup.get_node("VBox/menu/VBox/groupname").text=newname
		applygroupcolor(thegroup,newcolor)
		if saveasked==false: saveasked=true ; savetimer.start(1)
		warning("Changed group name to: "+newname,"black"))
	
func rebuildknots()->void:
	# rebuild array of knots and of groups after changes
	var newknotlist:=[] ; var newgrouplist:=[]
	for item in %knotlist.get_children():
		if "model" in item.name:pass
		elif item is PanelContainer: # item is a group of knots
			if not newgrouplist.has(item.get_meta("name")):
				newgrouplist.push_back({"name":item.get_meta("name"),"knots":[],"collapsed":bool(item.get_meta("collapsed")),"color":normalizegroupcolor(item.get_meta("color",defaultgroupcolor()))})
			for knot in item.get_node("VBox/knots").get_children(): 
				newknotlist.push_back(knot.get_meta("name")) 
				for gr in newgrouplist:
					if gr.name==item.get_meta("name"): 
						gr.knots.push_back(knot.get_meta("name")) ; break
		else:  # item is a knot without group
			newknotlist.push_back(item.get_meta("name")) 
		
	Autoload.allknots=newknotlist ; Autoload.knotgroups=newgrouplist

func _on_newgroup_pressed()-> void:
	if Autoload.jsonfolder.length()<2:
		popup("You must create or load a project first") ; return

	await promptgroupname("Create a group", "", defaultgroupcolor(), func(groupname,groupcolor):
		creategroup(groupname,groupcolor))

func creategroup(groupname, groupcolor:="") -> void:
	if groupcolor=="": groupcolor=defaultgroupcolor()
	groupname=str(groupname).strip_edges()
	if groupname=="":
		popup("Group name cannot be empty") ; return
	if groupnameexists(groupname):
		popup("Group name already exists") ; return
	
	var newgroup:=%knotlist/groupmodel.duplicate()
	newgroup.get_node("VBox/menu/VBox/groupname").text=groupname
	newgroup.name=groupname ; newgroup.set_meta("name",groupname)
	newgroup.set_meta("drag_type","group")
	newgroup.set_meta("collapsed",false)
	applygroupcolor(newgroup,groupcolor)
	newgroup.get_node("VBox/menu/VBox/up").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"up"))
	newgroup.get_node("VBox/menu/VBox/down").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"down"))
	newgroup.get_node("VBox/menu/VBox/change").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"change"))
	newgroup.get_node("VBox/menu/VBox/collapse").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"collapse"))
	newgroup.get_node("VBox/menu/VBox/erase").connect("pressed",Callable(self,"arrangegroups").bind(newgroup,"delete"))
	$UI.setup_knot_list_drag(newgroup)
	%knotlist.add_child(newgroup) ; %knotlist.move_child(newgroup,$UI.get_knot_list_first_movable_index())
	newgroup.show()
	setgroupcollapsed(newgroup,false)

	if saveasked==false: saveasked=true ; savetimer.start(1) # rebuild knot arrays and autosave
	warning("Created new group called: "+str(groupname),"black")

