func savejson() -> void:
	if knotname.length()<1:return
	
	if Autoload.jsonfolder=="":
		popup("You need to choose a json folder first")
		return

	if is_translation_editor_mode():
		if not %translationview.save_current_knot(knotname):
			return
		var translation_timestamp = "%02d:%02d" % [Time.get_datetime_dict_from_system().hour, Time.get_datetime_dict_from_system().minute]
		warning("Json saved: "+str(knotname)+ " - "+str(translation_timestamp),"black")
		knotchanged=false
		_on_play_pressed()
		displayeditor()
		return
	
	buildknotarray()
	var linecount:=0
	var lines:= {}
	for line in knotarray:
		if line.strip_edges()!="":
			linecount+=1
			lines[linecount]=line
	# check if there is an existing json for this knot
	var existingjson:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+knotname+".json")
	# parse and convert inktype dictionnary into json
	var newjson:Dictionary=$inkminconverter.parseinkfile(lines,true,existingjson)
	if not newjson.has(knotname):
		print("json not saved : error parsing "+knotname)
		return
	# save converted inkytype dictionnary into json
	if not $inkminconverter.save_dict_to_json_file(newjson[knotname],Autoload.jsonfolder+knotname+".json"):
		knotchanged=true
		return

	# rebuild root json to include all knots
	var rootcontent:Dictionary=$inkminreader.load_json_file(Autoload.jsonfolder+"root.json")
	rootcontent.root.knots=Autoload.allknots
	rootcontent.root["groups"]=Autoload.knotgroups
	if not $inkminconverter.save_dict_to_json_file(rootcontent,Autoload.jsonfolder+"root.json"):
		knotchanged=true
		return
	$inkminreader.allknots=Autoload.allknots.duplicate()
	var timestamp = "%02d:%02d" % [Time.get_datetime_dict_from_system().hour, Time.get_datetime_dict_from_system().minute]
	warning("Json saved: "+str(knotname)+ " - "+str(timestamp),"black")
	knotchanged=false
	if knotname=="root":
		reloadplayervarsfromroot(newjson[knotname])
	_on_play_pressed()
	displayeditor()

